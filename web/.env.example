# Shared rate limit store (Upstash Redis). Required in production: without it the
# /api/parse route answers 503, while the website keeps working.
# The Vercel Marketplace Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limits (defaults shown)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=100
RATE_LIMIT_GLOBAL_PER_DAY=2000

# Comma separated addresses or prefixes to refuse, e.g. 203.0.113.,2001:db8:1234:
BLOCKED_IPS=

# Set to true to turn the API off entirely
PARSE_API_DISABLED=false

# Only for testing a production build without Redis: per-instance counters
ALLOW_IN_MEMORY_RATE_LIMIT=false
